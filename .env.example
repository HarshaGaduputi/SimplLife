# ---- TaskNest ----
# Remove the "#" from the next line to enable persistence via PostgreSQL.
# DATABASE_URL=postgresql://user:pass@localhost:5432/tasknest

JWT_SECRET=tasknest-dev-secret-change-me-in-production
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# SMTP Outgoing Mail Server Host
SMTP_HOST=localhost
# SMTP Outgoing Mail Server Port (usually 587 or 465)
SMTP_PORT=587
# SMTP Username
SMTP_USER=user@example.com
# SMTP Password
SMTP_PASS=password
# Sender Address for system emails
SMTP_FROM_EMAIL=no-reply@simpllife.com
# Display name of the sender
SMTP_FROM_NAME=SimplLife

